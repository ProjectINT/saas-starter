# Required. The app does not start without these (see core/config/env.ts).
# Local stack: `npm run db:start && npm run env:local` writes them to .env.local.
# Hosted: Supabase Dashboard -> Project Settings -> API Keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS: never expose it to the browser.
SUPABASE_SECRET_KEY=

# Email (core/email). Required: smtp | resend | console. `npm run env:local`
# sets smtp to the local Mailpit (and the local hook secret) if they are missing.
EMAIL_PROVIDER=
# Sender of every email, e.g. "Acme <noreply@acme.com>" (a domain verified with the provider).
EMAIL_FROM=
# smtp: SMTP_SECURE=true for TLS from the start (port 465); otherwise STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# resend: API key from resend.com.
RESEND_API_KEY=
# Supabase Auth Send Email Hook secret (v1,whsec_...): Dashboard -> Authentication
# -> Hooks -> Send Email. The local one is in supabase/config.toml.
SEND_EMAIL_HOOK_SECRET=
# Origin for links in invitation and welcome emails. Optional on Vercel (the
# deployment URL is used) and locally (http://localhost:3000).
SITE_URL=

# Optional captcha on sign-in, sign-up and password reset: turnstile | hcaptcha.
# Supabase Auth checks the token, so enable the same provider with its secret
# key there too ([auth.captcha] in supabase/config.toml, or Dashboard ->
# Authentication -> Attack Protection). Test site keys that always pass:
#   turnstile 1x00000000000000000000AA   (secret 1x0000000000000000000000000000000AA)
#   hcaptcha  10000000-ffff-ffff-ffff-000000000001 (secret 0x0000000000000000000000000000000000000000)
NEXT_PUBLIC_CAPTCHA_PROVIDER=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Optional: version attached to error reports (defaults to the commit SHA on
# Vercel). Where errors go is set in core/config/monitoring.ts.
NEXT_PUBLIC_APP_RELEASE=

# Dev-only, not read by the app: `npm run i18n:translate` machine-translates
# new dictionary texts with the OpenAI API.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
